{
  "name": "pathway",
  "version": "0.1.0",
  "description": "Talks as landscapes: presentations where the content is a map and the talk is a route through it.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "pathway": "./bin/pathway.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "pathway": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "e2e": "node scripts/e2e.mjs",
    "calibrate": "node scripts/calibrate.mjs examples/pathway/pathway.md test/fixtures/calibration/calibration.md test/fixtures/kitchen/kitchen.md",
    "check:example": "node src/cli.ts check examples/pathway/pathway.md"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "qrcode-generator": "2.0.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "typescript": "6.0.3"
  }
}
